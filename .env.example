# Backend Heardle
HEARDLE_API_URL=https://be.heardleitalia.com/api

# Credenziali con cui l'updater si autentica sul backend per gli endpoint
# /insert/*. Prima il token si prendeva da GET /api/refresh, che era pubblico:
# ora quell'endpoint richiede a sua volta un token, quindi servono credenziali.
HEARDLE_ADMIN_USERNAME=
HEARDLE_ADMIN_PASSWORD=

# Stesso segreto JWT del backend: il servizio di controllo valida i token emessi
# da /api/authenticate, così il back office ha un solo login.
# Attenzione: dev'essere identico a JWT_SECRET del backend, byte per byte.
JWT_SECRET=

# Origin ammessi dal browser sul servizio di controllo (elenco separato da virgole).
# Es: https://heardleitalia.com,http://localhost:5173
UPDATER_CORS_ORIGINS=*

# Porta pubblicata sull'host per il servizio di controllo.
UPDATER_PORT=8090

# Solo per lo sviluppo locale: salta la verifica del token. Mai in produzione.
# UPDATER_AUTH_DISABLED=true

# YouTube Music
YTMUSIC_HEADERS=

# Tor
TOR_PROXY_URL=socks5h://tor-proxy:9050
TOR_CONTROL_HOST=tor-proxy
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
